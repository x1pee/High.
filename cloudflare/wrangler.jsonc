{
	"$schema": "https://developers.cloudflare.com/schemas/wrangler.json",
	"name": "high-sync",
	"main": "./worker.mjs",
	"compatibility_date": "2026-09-24",
	"workers_dev": true,
	"vars": {
		"ALLOWED_ORIGINS": "tauri://localhost,http://tauri.localhost,https://tauri.localhost,capacitor://localhost,http://localhost:1420",
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "high-sync",
			"database_id": "0b1bc10a-7b6f-4684-90c6-f799be71b39d",
			"migrations_dir": "./migrations",
		},
	],
}
