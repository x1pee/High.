{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "High",
  "version": "2.0.0",
  "identifier": "life.high.desktop",
  "build": {
    "beforeDevCommand": "node scripts/build-tauri.mjs",
    "beforeBuildCommand": "node scripts/build-tauri.mjs",
    "frontendDist": "../tauri-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "High.",
        "width": 1440,
        "height": 960,
        "minWidth": 360,
        "minHeight": 480,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost https://high-sync.high-sync-x1pee-2026.workers.dev; object-src 'none'; base-uri 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNDOUYwOEE3RTA4MTIzMDgKUldRSUk0SGdwd2lmUFBBZ1pQUUltejlGOUJ5bjMyeFJGV3JOb3p5NjFkeXVIVjhRVGNSTldJaDMK",
      "endpoints": [
        "https://github.com/x1pee/High./releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
